5,"n":200},"champion":"runs/r3/net_15.npy","search":"Big M=0.835 Smith=0.735 Witch=0.667 GA ba=0.672 bots=0.746","run":"r3"},{"t":"2026-11-17T10:58:04","kind":"goal_best","iter":2,"check":{"score":0.67,"n":200},"champion":"runs/r3/net_2.npy","search":"Big M=0.855 Smith=0.745 Witch=0.667 GA ba=0.670 bots=0.756","run":"r3"},{"t":"2026-11-17T10:53:29","kind":"goal_best","iter":1,"check":{"score":0.6675,"n":200},"champion":"runs/r3/net_1.npy","search":"Big M=0.863 Smith=0.745 Witch=0.703 GA ba=0.667 bots=0.770","run":"r3"},{"t":"2026-11-17T10:47:40","kind":"init_done","init_from":"runs/study/net_357_vq.npy","search":"Big M=0.860 Smith=0.755 Witch=0.670 GA ba=0.665 bots=0.762","net":"Big M=0.865 Smith=0.745 Witch=0.665 GA ba=0.647 bots=0.758","run":"r3"},{"t":"2026-11-17T10:45:29","kind":"run_start","config":{"nh":128,"sims":400,"eval_sims":400,"cpuct":1.5,"lam":0.5,"temp_turns":6,"noise":0,"target":2,"c_scale":0.1,"games":1000,"vs_ga_share":0.3,"vs_bot_share":0.2,"buffer_iters":5,"epochs":1,"batch":512,"lr":0.001,"warm_games":12000,"warm_epochs":8,"eval_kingdoms":50,"workers":7,"iterations":1000,"goal_every":10,"prior_temp":1.0,"prior_eps":0.0,"vq":1.0,"value_weight":1.0,"l2":0.0001},"init_from":"runs/study/net_357_vq.npy","run":"r3"},{"kind":"goal_check","t":"2026-11-17 13:37:43","label":"r4 iteration 20 + search","note":"400 sims, leaf 1.0 net + 0 rollout","policy":"runs/r4/net_20.npy","n":1000,"score":0.6765,"ci":[0.6469,0.7048],"big_money":0.845,"smithy_bm":0.7275,"witch_bm":0.6625,"sims":400,"lam":1.0,"cpuct":1.5,"ptemp":1.0,"peps":0.0,"rollout_net":0,"secs":174,"replay":null},{"kind":"goal_check","t":"2026-11-17 12:52:40","label":"r4 iteration 10 + search","note":"400 sims, leaf 1.0 net + 0 rollout","policy":"runs/r4/net_10.npy","n":1000,"score":0.6675,"ci":[0.6377,0.696],"big_money":0.825,"smithy_bm":0.7475,"witch_bm":0.67,"sims":400,"lam":1.0,"cpuct":1.5,"ptemp":1.0,"peps":0.0,"rollout_net":0,"secs":171,"replay":null},{"t":"2026-11-17 12:16:43","kind":"journal","title":"Run r3 stopped at iteration 20: an honest value head alone doesn't lift the plateau","text":"Goal checks (1,000 fresh games vs the GA base): 68.0% at iteration 10, 67.4% at 20; r2 was at 69-70%. The fresh value error (against the search's root value, measured on each iteration's new games before training on them) stayed at 0.05-0.06, so the head no longer memorises, but with half of every leaf value still coming from a GA rollout, the search judges positions the way the GA would finish them, and training can't change that half."},{"t":"2026-11-17 12:16:43","kind":"decision","title":"Run r4: leaf = value head only (lam = 1), the AlphaZero setting","text":"From r3's net 20, value target = the search's root value (vq = 1), 1 epoch per iteration. With the honest value head, value-only leaves scored 69.7% vs 70.2% for the half-rollout mix, so they are now viable, and they are the only setting in which the judge itself can improve through self-play. Also ~30% faster per simulation. Stop rule: no goal check above ~71% within ~30 iterations.","rejected":"net-buy rollouts (15x slower); more of r3"},{"kind":"goal_check","t":"2026-11-17 12:15:48","label":"r3 iteration 20 + search","note":"400 sims, leaf 0.5 net + 0.5 rollout","policy":"runs/r3/net_20.npy","n":1000,"score":0.674,"ci":[0.6443,0.7023],"big_money":0.825,"smithy_bm":0.7675,"witch_bm":0.65,"sims":400,"lam":0.5,"cpuct":1.5,"ptemp":1.0,"peps":0.0,"rollout_net":0,"secs":157,"replay":null},{"kind":"goal_check","t":"2026-11-17 11:34:32","label":"r3 iteration 10 + search","note":"400 sims, leaf 0.5 net + 0.5 rollout","policy":"runs/r3/net_10.npy","n":1000,"score":0.68,"ci":[0.6504,0.7082],"big_money":0.8275,"smithy_bm":0.7825,"witch_bm":0.68,"sims":400,"lam":0.5,"cpuct":1.5,"ptemp":1.0,"peps":0.0,"rollout_net":0,"secs":154,"replay":null},{"t":"2026-11-17 10:45:18","kind":"decision","title":"Run r3: value target = the search's root value, fresh value head, 1 epoch","text":"From net 357 with the value head retrained on Q (runs/study/net_357_vq.npy). Each iteration's value target is the search's root value Q instead of the game result (vq = 1), and the buffer is passed once per iteration instead of twice (5 passes per sample instead of 10). Policy target, self-play mix, 400 simulations and lam 0.5 stay as in r2. Measured before starting: the new head's held-out error 0.70 vs 1.24; search with it 70.3% (lam 0.5) and 69.7% (lam 1) vs 70.2% / 68.1% with the old head. The test is whether training with an honest value lifts the plateau. Stop rule: no goal check above ~71% within ~40 iterations.","rejected":"continuing r2 unchanged (flat for 250 iterations); net-buy rollouts (15x slower, +2 points at equal simulations, no better than 400 GA-rollout simulations); softer priors (no gain, 25% uniform 48%)"},{"t":"2026-11-17 10:40:16","kind":"journal","title":"Value study: a fresh value head trained on the search's root value fixes the memorising","text":"3,000 self-play games with net 357 (105,635 decisions), split by game 80/20, error against the final result on the held-out games (always predicting a draw: 0.97; the search's own root value Q as a prediction: 0.66). Net 357 as it is: 1.24. Further training from it with r2's recipe (10 passes): 1.33 (training error 0.06). With 2 / 1 passes 1.17 / 1.11; value weight 0.25: 1.24; l2 1e-3: 1.14; target (z+Q)/2: 1.12; target Q: 0.97, still poor because the old head is the starting point. With the value head reset (trunk kept) and 2 passes: target z 0.81, target Q 0.70; from the warm-start net, target Q 0.69 but the policy agreement drops from 97.6% to 93.6%. So: the trunk is fine, the old value head had learned confident nonsense, and Q is a far better label than the game result (one search's estimate per position instead of one coin flip per game)."},{"kind":"goal_check","t":"2026-11-17 10:21:31","label":"r2 search 100 sims, rollouts buy with the net","note":"","policy":"runs/r2/net_357.npy","n":1000,"score":0.6935,"ci":[0.6642,0.7213],"big_money":0.8425,"smithy_bm":0.7675,"witch_bm":0.655,"sims":100,"lam":0.5,"cpuct":1.5,"ptemp":1.0,"peps":0.0,"rollout_net":1,"secs":790,"replay":null},{"kind":"goal_check","t":"2026-11-17 10:08:07","label":"r2 search, prior temp 3, cpuct 3","note":"","policy":"runs/r2/net_357.npy","n":1000,"score":0.698,"ci":[0.6688,0.7257],"big_money":0.8725,"smithy_bm":0.7725,"witch_bm":0.6775,"sims":400,"lam":0.5,"cpuct":3.0,"ptemp":3.0,"peps":0.0,"rollout_net":0,"secs":183,"replay":null},{"t":"2026-11-17 10:05:14","kind":"journal","title":"The search has saturated: more simulations, other cpuct or softer priors don't help net 357","text":"Goal-check games (1,000 vs the GA base) with r2's net 357: net alone 66.7%; search with 100 / 400 / 1,600 simulations 67.3% / 70.2% / 69.5%; cpuct 0.75 / 1.5 / 3: 67.6% / 70.2% / 67.8%; leaf mix lam 0 / 0.25 / 0.5 / 0.75 / 1: 69.9% / 69.3% / 70.2% / 69.3% / 68.1%; prior temperature 2 / 4: 68.6% / 69.1%; prior mixed with 25% uniform: 48.0%. At the warm start the search added 7 points over the net; now it adds 3, and four times the simulations add nothing. The 25%-uniform result is the clearest: when the search is made to try every buy, noisy leaf values make some bad buy look best by luck, and the search picks it. The limit is the quality of the leaf evaluation (value head + GA rollout), not exploration."},{"kind":"goal_check","t":"2026-11-17 10:05:04","label":"r2 search, prior 25% uniform","note":"","policy":"runs/r2/net_357.npy","n":1000,"score":0.4795,"ci":[0.4487,0.5105],"big_money":0.7525,"smithy_bm":0.575,"witch_bm":0.485,"sims":400,"lam":0.5,"cpuct":1.5,"ptemp":1.0,"peps":0.25,"rollout_net":0,"secs":196,"replay":null},{"t":"2026-11-17 10:01:30","kind":"journal","title":"The value head memorises: out-of-sample error got worse during r2","text":"On 600 fresh games (net buys vs the GA base, both seats recorded), the value head's mean squared error against the final result was 0.68 for the warm-start net, 0.92 at iteration 100 and 1.17 at iteration 357, worse than always predicting a draw (0.97). The training log shows 0.19 for the same net: it is measured on the replay buffer, where each sample is seen about 10 times (2 epochs x 5 iterations) and all ~35 decisions of a game share one result, so the net learns the games, not the game. The search still scores 68% with the value alone at the leaves (lam = 1), because ranking buys needs less than calibrated values. Next: an offline study of value targets and regularisation (experiments/value_study.py)."},{"t":"2026-11-17 09:32:53","kind":"decision","title":"Leaf value: half net, half GA rollout (lam = 0.5)","text":"Measured on the warm-start net vs the GA base, 600 games each: net-only leaves scored 51% / 53% / 48% at 100 / 400 / 1,600 simulations, rollout-only 51% / 54% / 56%, the half-half mix 52% / 58% / 60%. The value net alone is too weak (MSE 0.6) and more search chases its errors; the rollout is unbiased but noisy; the mix wins.","rejected":"lam = 1 (AlphaZero's net-only leaves); lam = 0 (pure rollouts, 30% slower and weaker)"},{"t":"2026-11-17 09:32:53","kind":"decision","title":"Policy target: the search's chosen buy (expert iteration), no root noise","text":"AlphaZero's visit-share target collapsed the net in one iteration (r1: net alone 51.7% \u2192 24.3%): with near-equal buys the shares are the prior plus Dirichlet noise. Completed-Q (Gumbel) barely moves off a sharp prior. The one-hot of the most-visited buy made the net rise (r2). Exploration comes from sampling buys by visits in the first 6 turns and from games against the GA and the bots.","rejected":"visit shares (target 0); completed Q (target 1, c_scale 0.1)"},{"t":"2026-11-17 09:32:53","kind":"decision","title":"Self-play mix: 50% search vs search, 30% vs the GA base, 20% vs the three bots","text":"From iteration 1 to 5 of r2 the score vs the GA base rose (59.8% \u2192 63.0%) while the score vs Big Money / Smithy-BM / Witch-BM fell (78.9% \u2192 76.0%): specialising against one opponent. 20% of games against the bots from iteration 7 held them at ~78%.","rejected":"self-play only against itself; only against the GA"},{"t":"2026-11-17 09:32:53","kind":"decision","title":"Site moved to version 2 of the project-site template","text":"Overview / Log / Training / How it sees / The model (with generated figures of the real net) / Play / Speed / Study / Lessons / Podcast, a status strip on every page. The old one-page Log is now the Log tab; charts and the goal table are on Training.","rejected":""},{"t":"2026-11-16T04:37:44","kind":"goal_best","iter":93,"check":{"score":0.73,"n":200},"champion":"runs/r2/net_93.npy","search":"Big M=0.895 Smith=0.838 Witch=0.718 GA ba=0.730 bots=0.817","run":"r2"},{"t":"2026-11-16T02:26:59","kind":"goal_best","iter":61,"check":{"score":0.715,"n":200},"champion":"runs/r2/net_61.npy","search":"Big M=0.917 Smith=0.815 Witch=0.693 GA ba=0.715 bots=0.808","run":"r2"},{"t":"2026-11-16T01:21:05","kind":"goal_best","iter":45,"check":{"score":0.71,"n":200},"champion":"runs/r2/net_45.npy","search":"Big M=0.895 Smith=0.790 Witch=0.715 GA ba=0.710 bots=0.800","run":"r2"},{"kind":"goal_check","t":"2026-11-16 22:23:59","label":"r2 iteration 350 + search","note":"400 sims, leaf 0.5 net + 0.5 rollout","policy":"runs/r2/net_350.npy","n":1000,"score":0.695,"ci":[0.6658,0.7227],"big_money":0.8525,"smithy_bm":0.7725,"witch_bm":0.635,"sims":400,"lam":0.5,"secs":153,"replay":null},{"kind":"goal_check","t":"2026-11-16 21:42:40","label":"r2 iteration 340 + search","note":"400 sims, leaf 0.5 net + 0.5 rollout","policy":"runs/r2/net_340.npy","n":1000,"score":0.691,"ci":[0.6617,0.7189],"big_money":0.84,"smithy_bm":0.765,"witch_bm":0.6425,"sims":400,"lam":0.5,"secs":150,"replay":null},{"kind":"goal_check","t":"2026-11-16 21:01:45","label":"r2 iteration 330 + search","note":"400 sims, leaf 0.5 net + 0.5 rollout","policy":"runs/r2/net_330.npy","n":1000,"score":0.6915,"ci":[0.6622,0.7193],"big_money":0.86,"smithy_bm":0.7425,"witch_bm":0.65,"sims":400,"lam":0.5,"secs":152,"replay":null},{"kind":"goal_check","t":"2026-11-16 20:20:14","label":"r2 iteration 320 + search","note":"400 sims, leaf 0.5 net + 0.5 rollout","policy":"runs/r2/net_320.npy","n":1000,"score":0.687,"ci":[0.6576,0.715],"big_money":0.8425,"smithy_bm":0.7425,"witch_bm":0.675,"sims":400,"lam":0.5,"secs":152,"replay":null},{"kind":"goal_check","t":"2026-11-16 19:38:55","label":"r2 iteration 310 + search","note":"400 sims, leaf 0.5 net + 0.5 rollout","policy":"runs/r2/net_310.npy","n":1000,"score":0.6905,"ci":[0.6612,0.7184],"big_money":0.84,"smithy_bm":0.76,"witch_bm":0.6525,"sims":400,"lam":0.5,"secs":151,"replay":null},{"kind":"goal_check","t":"2026-11-16 18:57:52","label":"r2 iteration 300 + search","note":"400 sims, leaf 0.5 net + 0.5 rollout","policy":"runs/r2/net_300.npy","n":1000,"score":0.6825,"ci":[0.653,0.7106],"big_money":0.845,"smithy_bm":0.75,"witch_bm":0.64,"sims":400,"lam":0.5,"secs":157,"replay":null},{"kind":"goal_check","t":"2026-11-16 18:16:30","label":"r2 iteration 290 + search","note":"400 sims, leaf 0.5 net + 0.5 rollout","policy":"runs/r2/net_290.npy","n":1000,"score":0.685,"ci":[0.6555,0.713],"big_money":0.8375,"smithy_bm":0.755,"witch_bm":0.6725,"sims":400,"lam":0.5,"secs":152,"replay":null},{"kind":"goal_check","t":"2026-11-16 17:34:55","label":"r2 iteration 280 + search","note":"400 sims, leaf 0.5 net + 0.5 rollout","policy":"runs/r2/net_280.npy","n":1000,"score":0.6815,"ci":[0.652,0.7096],"big_money":0.8525,"smithy_bm":0.745,"witch_bm":0.6525,"sims":400,"lam":0.5,"secs":152,"replay":null},{"kind":"goal_check","t":"2026-11-16 16:51:10","label":"r2 iteration 270 + search","note":"400 sims, leaf 0.5 net + 0.5 rollout","policy":"runs/r2/net_270.npy","n":1000,"score":0.6655,"ci":[0.6357,0.6941],"big_money":0.8425,"smithy_bm":0.7275,"witch_bm":0.65,"sims":400,"lam":0.5,"secs":177,"replay":null},{"kind":"goal_check","t":"2026-11-16 16:08:41","label":"r2 iteration 260 + search","note":"400 sims, leaf 0.5 net + 0.5 rollout","policy"