:1000,"vs_ga_share":0.3,"buffer_iters":5,"epochs":2,"batch":512,"lr":0.001,"warm_games":12000,"warm_epochs":8,"eval_kingdoms":50,"workers":7,"iterations":0},"run":"warm"},{"t":"2026-11-15T21:44:09","kind":"baseline","label":"GA base genome (portfolio-v2 specialist per kingdom)","Big Money":0.8725,"Smithy-BM":0.6975,"Witch-BM":0.705,"GA base":0.5,"bots":0.7583333333333333,"run":"warm"},{"kind":"goal_check","t":"2026-11-15 23:42:09","label":"r2 iteration 20 + search","note":"400 sims, leaf 0.5 net + 0.5 rollout","policy":"runs/r2/net_20.npy","n":1000,"score":0.6515,"ci":[0.6214,0.6804],"big_money":0.83,"smithy_bm":0.7675,"witch_bm":0.635,"sims":400,"lam":0.5,"secs":148,"replay":null},{"kind":"goal_check","t":"2026-11-15 23:01:36","label":"r2 iteration 10 + search","note":"400 sims, leaf 0.5 net + 0.5 rollout","policy":"runs/r2/net_10.npy","n":1000,"score":0.6345,"ci":[0.6042,0.6638],"big_money":0.8625,"smithy_bm":0.775,"witch_bm":0.675,"sims":400,"lam":0.5,"secs":148,"replay":null},{"t":"2026-11-15 22:20:09","title":"Run r1 stopped after one iteration: the net learned noise","text":"Iteration 1 of r1 trained the net on the search's visit shares. With 400 simulations and values this close together, those shares are mostly the net's own prior plus the Dirichlet exploration noise, so the net learned a flatter, noisier policy: alone it fell from 51.7% to 24.3% against the GA base (search still held 57.5%, because the rollouts carry it). Same failure as the smoke test, slower. A completed-Q target (Gumbel AlphaZero) was tried next: with the warm net's sharp prior it barely moves off the prior. Run r2 uses expert iteration instead: the target is the search's chosen buy (most visits), the root gets no Dirichlet noise, exploration comes from drawing buys by visit counts in the first 6 turns and from the 30% of games against the GA. r2 reuses r1's warm start (iteration 0).","kind":"journal"}]